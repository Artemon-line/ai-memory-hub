<article class="panel endpoint-panel">
  <div class="panel-header">
    <span class="panel-icon" aria-hidden="true">MCP</span>
    <div>
      <h2>Endpoint</h2>
      <p>Use this resource URL from local or LAN clients.</p>
    </div>
  </div>
  <dl class="status-list">
    <div>
      <dt>Status</dt>
      <dd><span class="status-pill status-pill--ok">ok</span></dd>
    </div>
    <div>
      <dt>MCP URL</dt>
      <dd><code class="endpoint-code">{{ mcp_url|e }}</code></dd>
    </div>
  </dl>
</article>
