<article class="panel auth-panel">
  <div class="panel-header">
    <span class="panel-icon" aria-hidden="true">ID</span>
    <div>
      <h2>Sign-in</h2>
      <p>For MCP clients that support OAuth.</p>
    </div>
  </div>

  <dl class="status-list">
    <div>
      <dt>Access mode</dt>
      <dd>
        <span class="status-pill{% if auth_mode.tone == 'ok' %} status-pill--ok{% elif auth_mode.tone == 'pending' %} status-pill--pending{% endif %}">{{ auth_mode.label|e }}</span>
      </dd>
    </div>
    <div>
      <dt>Browser session</dt>
      <dd>
        <span class="status-pill{% if signed_in %} status-pill--ok{% endif %}">{{ auth_label|e }}</span>
      </dd>
    </div>
    {% if identity %}
    <div>
      <dt>Identity</dt>
      <dd>{{ identity|e }}</dd>
    </div>
    {% endif %}
  </dl>
  <p class="panel-note">{{ auth_mode.description|e }}</p>

  {% if signed_in and csrf_token and pending_oauth_authorization %}
  <div class="oauth-approval" role="status">
    <h3>Authorize local client</h3>
    <dl class="status-list">
      <div>
        <dt>Client</dt>
        <dd>{{ pending_oauth_authorization.client_name|e }}</dd>
      </div>
      <div>
        <dt>Redirect</dt>
        <dd><code>{{ pending_oauth_authorization.redirect_uri|e }}</code></dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd>{{ pending_oauth_authorization.scope|e }}</dd>
      </div>
    </dl>
    <div class="button-row">
      <form method="post" action="/oauth/authorize/approve">
        <input type="hidden" name="csrf_token" value="{{ csrf_token|e }}">
        <button type="submit" class="button button--primary">Authorize</button>
      </form>
      <form method="post" action="/oauth/authorize/deny">
        <input type="hidden" name="csrf_token" value="{{ csrf_token|e }}">
        <button type="submit" class="button button--secondary">Cancel</button>
      </form>
    </div>
  </div>
  {% elif signed_in and csrf_token %}
  <form method="post" action="/auth/logout">
    <input type="hidden" name="csrf_token" value="{{ csrf_token|e }}">
    <button type="submit" class="button button--secondary">Sign out</button>
  </form>
  {% elif auth_mode.value == 'oauth_resource_server' %}
  {% include "partials/provider_buttons.html.j2" %}
  {% elif auth_mode.value == 'bearer_token' %}
  <p class="muted">The Connect page intentionally does not render configured secrets.</p>
  {% else %}
  <p class="muted">Keep this service bound to loopback or another trusted interface.</p>
  {% endif %}
</article>
