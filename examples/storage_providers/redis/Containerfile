FROM ghcr.io/astral-sh/uv:0.11.32-python3.14-trixie-slim@sha256:c2971e36c3f826c5d0c59f009ecc5c2c5e90fe2ad2087d258b711cb7a453697f

LABEL org.opencontainers.image.title="ai-memory-hub-redis-example" \
      org.opencontainers.image.description="ai-memory-hub SQLite metadata and Redis vector example image" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    UV_CACHE_DIR=/app/.uv-cache

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./

RUN uv sync --frozen --no-dev \
      --extra redis \
      --no-install-project

COPY memory ./memory
COPY examples/container/config.yaml /app/config.yaml

RUN uv sync --frozen --no-dev \
      --extra redis && \
    test -x /app/.venv/bin/aim && \
    mkdir -p /app/data /app/logs /app/.uv-cache && \
    useradd --uid 1001 --gid 0 --home-dir /tmp --no-create-home \
      --shell /usr/sbin/nologin ai-memory-hub && \
    chgrp -R 0 /app && \
    chmod -R g=u /app && \
    chown -R 1001:0 /app/.uv-cache && \
    chmod -R g=u /app/.uv-cache

EXPOSE 8000

USER 1001

CMD ["/app/.venv/bin/aim", "serve", "--host", "0.0.0.0", "--port", "8000"]
